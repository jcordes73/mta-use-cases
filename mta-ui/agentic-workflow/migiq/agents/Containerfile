# MigIQ agent image: Konveyor agent-java + rgctl built for this image's glibc.
ARG BASE_IMAGE=quay.io/konveyor/agent-java:latest

FROM ${BASE_IMAGE} AS rgctl-builder
ARG RGCTL_VERSION=0.4.24
ARG RGCTL_REPO=https://github.com/rgctl/rgctl.git
USER root
RUN set -eux; \
    dnf install -y gcc gcc-c++ make git openssl-devel \
      && dnf clean all; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal; \
    . "$HOME/.cargo/env"; \
    git clone --depth 1 --branch "v${RGCTL_VERSION}" "${RGCTL_REPO}" /tmp/rgctl-src; \
    cd /tmp/rgctl-src; \
    cargo build --release -p rgctl; \
    install -m 0755 target/release/rgctl /usr/local/bin/rgctl; \
    test -x /usr/local/bin/rgctl; \
    /usr/local/bin/rgctl --version

FROM ${BASE_IMAGE}
USER root
COPY --from=rgctl-builder /usr/local/bin/rgctl /usr/local/bin/rgctl
RUN test -x /usr/local/bin/rgctl && /usr/local/bin/rgctl --version
# The multiple MigIQ + rgctl skills, matching the layout of the former
# skills/Containerfile (one directory per skill at the image root; each
# SkillCard selects one via subPath). The build context (--from-dir) is this
# directory's parent, so the skills live under skills/ in it.
COPY skills/migiq /migiq
COPY skills/mig-rgctl /mig-rgctl
COPY skills/mig-prompt-builder /mig-prompt-builder
COPY skills/mig-plan /mig-plan
COPY skills/mig-execute /mig-execute
COPY skills/mig-test-gen /mig-test-gen
COPY skills/mig-containerize /mig-containerize
COPY skills/mig-deploy /mig-deploy
COPY skills/mig-verify /mig-verify
COPY skills/rgctl /rgctl
COPY skills/rgctl-review /rgctl-review
# MCP servers for the goose harness: goose reads its "extensions" from
# $XDG_CONFIG_HOME/goose/config.yaml at startup. The migration harness only
# sets provider/model env vars and never writes this file, so image-baked
# extensions load in every AgentRun using this image. XDG_CONFIG_HOME is
# pinned because uid 1001's HOME depends on the base image's passwd entry.
ENV XDG_CONFIG_HOME=/opt/goose-config
COPY goose-config.yaml /opt/goose-config/goose/config.yaml
RUN chmod 0644 /opt/goose-config/goose/config.yaml
# rhda-mcp-server: stdio MCP server wrapping the RHDA (Red Hat Dependency
# Analytics / Trustify) backend - dependency vulnerability analysis and
# remediation planning as agent tools. Not published to npm (private
# package), so clone and install at build time; runs on tsx, which ships
# as a devDependency (npm install includes dev deps by default). The
# extension command in goose-config.yaml addresses the tsx launcher via
# its node_modules path because goose spawns commands with the sandbox
# workdir as cwd. ARG RHDA_MCP_REF pins the upstream revision - the repo
# is a personal repository without release tags at draft time, so use a
# commit SHA for reproducible builds.
RUN dnf install -y nodejs npm && dnf clean all
ARG RHDA_MCP_REF=main
RUN set -eux; \
    git clone https://github.com/ruromero/rhda-mcp-server.git /opt/rhda-mcp-server; \
    cd /opt/rhda-mcp-server; \
    git fetch --depth 1 origin "${RHDA_MCP_REF}"; \
    git checkout --detach FETCH_HEAD; \
    npm install; \
    test -x node_modules/.bin/tsx; \
    node_modules/.bin/tsx --version
USER 1001
ENTRYPOINT ["migration-harness"]
CMD ["run"]
